.DS_Store
# Local clone of the GitHub wiki (github.com/Tomorrow-Tech-s-r-l/station_cli.wiki.git).
# Never track it: committing it adds a gitlink with no .gitmodules entry, which
# makes actions/checkout wipe and re-clone the whole self-hosted workspace.
station_cli.wiki/
.test-build/

# Generated by the release job (build.yml), never committed: metadata.json is
# computed from the contract evidence by release-compat (`compat metadata`),
# and bundle/ holds this build's tag and the compatibility.json packed into
# the executable.
/metadata.json
/bundle/
